---
import Footer from './Footer.astro';
---

<section class="contact" id="contact">
  <div class="container">

    <h2 class="contact__heading reveal">
      Benieuwd of dit bij jou past?
    </h2>

    <p class="contact__body reveal reveal-delay-1">
      Stuur een mail. Vertel kort wat er speelt, dan kijk ik met je mee
      wat er nodig is. Geen verplichtingen, geen standaard pitch.
    </p>

    <a href="mailto:info@jescoinnovation.nl" class="contact__email reveal reveal-delay-2">
      info@jescoinnovation.nl
    </a>

    <div class="contact__meta reveal reveal-delay-3">
      <span>Jesco Innovation BV</span>
      <span>KVK: &lt;nummer invullen&gt;</span>
      <span>Jesco Trainingen</span>
    </div>

  </div>
</section>

<Footer />
