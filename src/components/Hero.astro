---
---

<section class="hero">

  <!-- Full-bleed achtergrond foto -->
  <div class="hero__photo-wrap" aria-hidden="true">
    <img
      class="hero__photo-img"
      src="/images/jesse-masterclass.jpg"
      alt=""
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <!-- Inhoud — linksonder -->
  <div class="container hero__inner">
    <div class="hero__content">

      <p class="hero__kicker">Jesco Trainingen</p>

      <!-- Titel: elke regel in eigen wrap voor slide-up animatie -->
      <h1 class="hero__title">
        <span class="hero__line-wrap">
          <span class="hero__line hero__line--1">Vergaderen</span>
        </span>
        <span class="hero__line-wrap">
          <em class="hero__line hero__line--2">is een vak.</em>
        </span>
      </h1>

      <p class="hero__body">
        Maar niemand leert jou hoe het werkt — tot nu.
        Jesse Venniker traint teams in effectief vergaderen
        en bewust omgaan met AI.
      </p>

      <div class="hero__actions">
        <a href="/contact" class="btn btn--primary">Plan een gesprek</a>
        <a href="/trainingen" class="hero__link">Bekijk de trainingen →</a>
      </div>

    </div>
  </div>

  <!-- Verticale scrolllijn -->
  <div class="hero__scroll-wrap" aria-hidden="true">
    <span class="hero__scroll-line"></span>
  </div>

</section>
