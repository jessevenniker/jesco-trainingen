---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Pagina niet gevonden — Jesco Trainingen"
  description="Deze pagina bestaat niet. Maar de masterclass wel."
>
  <Nav />
  <main class="not-found">
    <div class="container">
      <p class="not-found__num">404</p>
      <p class="not-found__line">
        Deze pagina bestaat niet.<br />
        <em>Maar mijn masterclass wel.</em>
      </p>
      <a href="/trainingen" class="btn btn--primary">Bekijk de trainingen</a>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .not-found {
    min-height: 80vh;
    display: flex;
    align-items: center;
    background: var(--ink);
    padding-block: var(--sp-2xl);
  }

  .not-found__num {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(6rem, 20vw, 14rem);
    font-weight: 400;
    line-height: 1;
    color: var(--accent);
    letter-spacing: -0.04em;
    margin-bottom: var(--sp-m);
    opacity: 0.35;
  }

  .not-found__line {
    font-family: var(--serif);
    font-size: var(--text-2xl);
    color: var(--bg);
    line-height: 1.3;
    margin-bottom: var(--sp-l);
  }

  .not-found__line em {
    font-style: italic;
    color: rgba(247, 243, 238, 0.55);
  }
</style>
