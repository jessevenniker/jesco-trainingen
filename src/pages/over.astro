---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import About from '../components/About.astro';
import Interlude from '../components/Interlude.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Over Jesse — Jesco Trainingen"
  description="Jesse Venniker is psycholoog en trainer. Hij werkt met teams die merken dat vergaderen beter kan en organisaties die AI willen begrijpen."
>
  <Nav />
  <main>

    <header class="page-header">
      <div class="container">
        <p class="page-header__kicker">Over Jesse</p>
        <h1 class="page-header__title">
          Ik werk met mensen, niet aan mensen.
        </h1>
      </div>
    </header>

    <About hideHeading />

    <Interlude
      quote="Authentiek."
      context="deelnemer, eerste training"
    />

    <!-- Methode -->
    <section class="methode">
      <div class="container">
        <div class="methode__inner">
          <div class="methode__text">
            <p class="methode__kicker reveal">Hoe Jesse werkt</p>
            <h2 class="methode__title reveal reveal-delay-1">
              Gedragsgericht. Onderbouwd. Contextgebonden.
            </h2>
            <div class="methode__body reveal reveal-delay-2">
              <p>
                Jesse is psycholoog van opleiding — en dat merk je. Zijn trainingen gaan
                niet alleen over structuur en theorie, maar over het concrete gedrag dat
                verandering in de praktijk zichtbaar maakt. Want kennis is pas waardevol
                als het verandert wat mensen doen.
              </p>
              <p>
                Elke training begint met een intake: wat speelt er in jouw team, wat is
                de context, wat zijn de echte knelpunten? Pas daarna wordt de inhoud
                samengesteld. Dat is geen service — het is een didactische keuze.
                Onderzoek van Edmondson (Harvard Business School) laat zien dat leren
                alleen beklijft als deelnemers zich veilig voelen om te oefenen, te
                falen en te bevragen. Die psychologische veiligheid ontwerp je bewust
                — en dat begint vóór de training start.
              </p>
            </div>
          </div>
          <div class="methode__pillars">
            <div class="methode__pillar reveal">
              <p class="methode__pillar-title">Gedragsgericht</p>
              <p class="methode__pillar-desc">
                Elke training werkt toe naar concreet, observeerbaar gedrag.
                Geen vage inzichten maar meetbare verandering.
              </p>
            </div>
            <div class="methode__pillar reveal reveal-delay-1">
              <p class="methode__pillar-title">Blended</p>
              <p class="methode__pillar-desc">
                Live training en e-learning versterken elkaar.
                Gespreide herhaling zorgt dat het beklijft.
              </p>
            </div>
            <div class="methode__pillar reveal">
              <p class="methode__pillar-title">Contextgebonden</p>
              <p class="methode__pillar-desc">
                Elke training vertrekt vanuit de situatie van jouw team.
                Geen generieke casussen, maar herkenbare werkelijkheid.
              </p>
            </div>
            <div class="methode__pillar reveal reveal-delay-1">
              <p class="methode__pillar-title">Psychologisch fundament</p>
              <p class="methode__pillar-desc">
                Groepsdynamiek, psychologische veiligheid en menselijk gedrag
                zijn geen bijzaken — ze zijn het vertrekpunt.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <Interlude
      quote="Staat rustig en stevig voor de groep."
      context="deelnemer, eerste training"
    />

    <!-- Resultaten — scores + quote masonry -->
    <section class="resultaten" id="resultaten">
      <div class="container">

        <p class="resultaten__kicker reveal">Wat deelnemers zeggen</p>
        <p class="resultaten__sub reveal reveal-delay-1">2 trainingen · 21 deelnemers · gemiddeld 9.3 / 10</p>

        <!-- Per-training vergelijking -->
        <div class="resultaten__trainingen">
          <div class="resultaten__training reveal">
            <p class="resultaten__training-label">Training 01 — CITI Curaçao · juni 2026</p>
            <div class="resultaten__scores resultaten__scores--compact">
              <div class="resultaten__score">
                <span class="resultaten__score-num" data-counter="9.4">9.4</span>
                <span class="resultaten__score-label">Beoordeling Jesse</span>
              </div>
              <div class="resultaten__score">
                <span class="resultaten__score-num" data-counter="9.5">9.5</span>
                <span class="resultaten__score-label">Aansluiting niveau</span>
              </div>
              <div class="resultaten__score">
                <span class="resultaten__score-num" data-counter="9.4">9.4</span>
                <span class="resultaten__score-label">Aanpassing uitleg</span>
              </div>
            </div>
            <p class="resultaten__training-typering">"Betrokken en afgestemd op de groep." — 7 van 8 deelnemers</p>
          </div>

          <div class="resultaten__training reveal reveal-delay-1">
            <p class="resultaten__training-label">Training 02 · juni 2026</p>
            <div class="resultaten__scores resultaten__scores--compact">
              <div class="resultaten__score">
                <span class="resultaten__score-num" data-counter="9.2">9.2</span>
                <span class="resultaten__score-label">Beoordeling Jesse</span>
              </div>
              <div class="resultaten__score">
                <span class="resultaten__score-num" data-counter="9.2">9.2</span>
                <span class="resultaten__score-label">Aansluiting niveau</span>
              </div>
              <div class="resultaten__score">
                <span class="resultaten__score-num" data-counter="9.2">9.2</span>
                <span class="resultaten__score-label">Aanpassing uitleg</span>
              </div>
            </div>
            <p class="resultaten__training-typering">"Duidelijk &amp; gestructureerd" + "Enthousiast &amp; energiek" — 11 van 13 deelnemers</p>
          </div>
        </div>

        <!-- Bar chart gecombineerd -->
        <div class="resultaten__chart reveal" aria-label="Hoe typeren deelnemers Jesse?">
          <p class="resultaten__chart-heading">Hoe typeren deelnemers Jesse? <span class="resultaten__chart-meta">Training 02, 13 respondenten</span></p>
          <ul class="proof-bars proof-bars--light">
            <li class="proof-bar" data-pct="85">
              <span class="proof-bar__label">Duidelijk &amp; gestructureerd</span>
              <span class="proof-bar__track"><span class="proof-bar__fill"></span></span>
              <span class="proof-bar__count">11</span>
            </li>
            <li class="proof-bar" data-pct="85">
              <span class="proof-bar__label">Enthousiast &amp; energiek</span>
              <span class="proof-bar__track"><span class="proof-bar__fill"></span></span>
              <span class="proof-bar__count">11</span>
            </li>
            <li class="proof-bar" data-pct="77">
              <span class="proof-bar__label">Betrokken &amp; afgestemd op de groep</span>
              <span class="proof-bar__track"><span class="proof-bar__fill"></span></span>
              <span class="proof-bar__count">10</span>
            </li>
            <li class="proof-bar" data-pct="62">
              <span class="proof-bar__label">Deskundig &amp; inhoudelijk sterk</span>
              <span class="proof-bar__track"><span class="proof-bar__fill"></span></span>
              <span class="proof-bar__count">8</span>
            </li>
          </ul>
        </div>

        <!-- Quote masonry — alle unieke antwoorden beide trainingen -->
        <p class="resultaten__quotes-heading reveal">Wat vond je het sterkste aan Jesse als trainer?</p>
        <div class="quote-masonry">

          <p class="quote-chip quote-chip--xl reveal">"Authentiek."</p>

          <p class="quote-chip quote-chip--l reveal">"Betrokken, kundig en goed voorbereid."</p>

          <p class="quote-chip quote-chip--l reveal">"Heel interactief. Goed betrokken, duidelijk en pakt het snel weer op."</p>

          <p class="quote-chip quote-chip--m reveal">"Staat rustig en stevig voor groep, goede interactie en procesbewaking."</p>

          <p class="quote-chip quote-chip--m reveal">"Was in de lead en sloot aan op interesses publiek."</p>

          <p class="quote-chip quote-chip--m reveal">"Communicatief en overwicht op de groep."</p>

          <p class="quote-chip quote-chip--m reveal">"Goede antwoorden op vragen, goede uitleg én duidelijkheid."</p>

          <p class="quote-chip quote-chip--s reveal">"Hij paste zich goed aan aan wat er gebeurde tijdens de training en wist waar hij het over had."</p>

          <p class="quote-chip quote-chip--s reveal">"Goede structuur, pakte terug waar nodig. Goed time management. Goede afwisseling tussen theorie, praktijk en interactieve oefening."</p>

          <p class="quote-chip quote-chip--s reveal">"Het terug oppakken als we afhaakten van het onderwerp — maar toch de mensen met elkaar laten discussiëren en ze vragen laten stellen."</p>

          <p class="quote-chip quote-chip--s reveal">"Hoe hij de onderwerpen verbindt met de groep."</p>

          <p class="quote-chip quote-chip--s reveal">"Zijn openheid tijdens de training."</p>

        </div>

      </div>
    </section>

    <section class="cta-banner">
      <div class="container">
        <p class="cta-banner__text reveal">
          Wil je weten of dit bij jouw situatie past?
        </p>
        <a href="/contact" class="cta-banner__link reveal reveal-delay-1">
          Neem contact op
        </a>
      </div>
    </section>

  </main>
  <Footer />
</Layout>
