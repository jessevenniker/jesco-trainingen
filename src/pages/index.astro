---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Results from '../components/Results.astro';
---

<Layout>
  <Nav />
  <main>
    <Hero />

    <!-- Kort probleem + score -->
    <section class="problem">
      <div class="container">
        <div class="problem__inner">
          <div class="problem__margin"></div>
          <div class="problem__content">
            <h2 class="problem__heading reveal">
              Wat gaat er eigenlijk mis?
            </h2>
            <div class="problem__body reveal reveal-delay-1">
              <p>
                De gemiddelde professional verliest <span class="stat">31 uur</span> per
                maand aan vergaderingen die hij of zij achteraf als zinloos ervaart. Dat
                zijn meer dan vier werkdagen. Niet omdat mensen het slecht bedoelen, maar
                omdat niemand ze ooit heeft geleerd hoe vergaderen eigenlijk werkt.
              </p>
            </div>
            <p class="problem__score reveal reveal-delay-2">
              8 van de 8 deelnemers beoordeelden de training met gemiddeld een <span class="stat">9.4</span>.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Trainingen overzicht -->
    <section class="teasers">
      <div class="container">
        <p class="teasers__kicker reveal">De trainingen</p>
        <ol class="teasers__list">

          <li>
            <a href="/trainingen" class="teasers__item reveal">
              <span class="teasers__num" aria-hidden="true">1</span>
              <div class="teasers__content">
                <p class="teasers__label">Effectief vergaderen</p>
                <h3 class="teasers__title">Je kunt het leren. En beter leren doen.</h3>
              </div>
              <span class="teasers__arrow">Lees meer →</span>
            </a>
          </li>

          <li>
            <a href="/trainingen" class="teasers__item reveal reveal-delay-1">
              <span class="teasers__num" aria-hidden="true">2</span>
              <div class="teasers__content">
                <p class="teasers__label">AI als hulpmiddel op de werkvloer</p>
                <h3 class="teasers__title">Sneller waar het helpt. Bewuster waar het niet helpt.</h3>
              </div>
              <span class="teasers__arrow">Lees meer →</span>
            </a>
          </li>

          <li>
            <a href="/trainingen" class="teasers__item reveal reveal-delay-2">
              <span class="teasers__num" aria-hidden="true">3</span>
              <div class="teasers__content">
                <p class="teasers__label">Verantwoord omgaan met AI</p>
                <h3 class="teasers__title">De mens aan het stuur. Niet als rem, maar als fundament.</h3>
              </div>
              <span class="teasers__arrow">Lees meer →</span>
            </a>
          </li>

        </ol>
        <div class="teasers__cta-wrap reveal">
          <a href="/trainingen" class="teasers__cta">Bekijk alle trainingen</a>
        </div>
      </div>
    </section>

    <!-- E-learning preview -->
    <section class="elearning-preview">
      <div class="container">
        <div class="elearning-preview__inner">
          <div class="elearning-preview__text reveal">
            <p class="elearning-preview__kicker">Ook digitaal beschikbaar</p>
            <h2 class="elearning-preview__title">Modern Meeting Skills — ook als e-learning.</h2>
            <p class="elearning-preview__body">8 modules, 4,5 uur, zelfstandig te doorlopen.</p>
            <a href="/elearning" class="elearning-preview__link">Bekijk de e-learning →</a>
          </div>
          <div class="elearning-preview__screenshot reveal reveal-delay-1">
            <div class="elearning__screenshot">
              <img src="/images/modern-meeting-skills-module-overzicht.png" alt="Modern Meeting Skills e-learning — moduleoverzicht" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Quotes -->
    <Results />

    <!-- CTA banner -->
    <section class="cta-banner">
      <div class="container">
        <p class="cta-banner__text reveal">
          Benieuwd of dit bij jouw team past?
        </p>
        <a href="/contact" class="cta-banner__link reveal reveal-delay-1">
          Neem contact op
        </a>
      </div>
    </section>

  </main>
</Layout>
