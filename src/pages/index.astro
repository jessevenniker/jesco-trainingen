---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Nav />
  <main>
    <Hero />
    <Marquee />

    <!-- Probleem -->
    <section class="problem">
      <div class="container">
        <div class="problem__inner">
          <div class="problem__big-num" aria-hidden="true">31</div>
          <div class="problem__content">
            <h2 class="problem__heading reveal">
              Wat gaat er eigenlijk mis?
            </h2>
            <div class="problem__body reveal reveal-delay-1">
              <p>
                De gemiddelde professional verliest <span class="stat">31 uur</span> per
                maand aan vergaderingen die achteraf als zinloos worden ervaren. Dat zijn
                meer dan vier werkdagen. Niet omdat mensen het slecht bedoelen — maar
                omdat niemand ze ooit heeft geleerd hoe vergaderen eigenlijk werkt.
                Onderzoek bevestigt dit consequent.
              </p>
            </div>
          </div>
        <!-- Statistieken uit onderzoek -->
        <div class="problem__stats">
          <div class="problem__stat reveal">
            <span class="problem__stat-num">17%</span>
            <span class="problem__stat-desc">van de werktijd gaat op aan vergaderingen, ongeacht of ze waarde toevoegen</span>
            <span class="problem__stat-source">OECD, 2017</span>
          </div>
          <div class="problem__stat reveal reveal-delay-1">
            <span class="problem__stat-num">72%</span>
            <span class="problem__stat-desc">van professionals verliest structureel tijd door slecht georganiseerde meetings</span>
            <span class="problem__stat-source">Doodle State of Meetings Report, 2019</span>
          </div>
          <div class="problem__stat reveal reveal-delay-2">
            <span class="problem__stat-num">10 uur</span>
            <span class="problem__stat-desc">directe personeelskosten per vergadering van tien mensen die één uur duurt</span>
            <span class="problem__stat-source">LeBlanc & Nosik, 2019</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Trainingen — kaarten met foto -->
    <section class="teasers">
      <div class="container">
        <p class="teasers__kicker reveal">De trainingen</p>
        <div class="teasers__grid">

          <a href="/trainingen/effectief-vergaderen" class="teasers__card reveal">
            <div class="teasers__card-photo">
              <img
                src="https://images.unsplash.com/photo-1519389950473-47ba0277781c?w=800&q=80"
                alt="Team in vergadering"
                loading="lazy"
              />
            </div>
            <div class="teasers__card-body">
              <span class="teasers__card-num">01</span>
              <p class="teasers__label">Effectief vergaderen</p>
              <h3 class="teasers__title">Je kunt het leren. En beter leren doen.</h3>
              <span class="teasers__card-arrow">Lees meer →</span>
            </div>
          </a>

          <a href="/trainingen/ai-hulpmiddel" class="teasers__card reveal reveal-delay-1">
            <div class="teasers__card-photo">
              <img
                src="https://images.unsplash.com/photo-1488229297570-58520851e868?w=800&q=80"
                alt="Professional werkt met AI tools"
                loading="lazy"
              />
            </div>
            <div class="teasers__card-body">
              <span class="teasers__card-num">02</span>
              <p class="teasers__label">AI als hulpmiddel op de werkvloer</p>
              <h3 class="teasers__title">Sneller waar het helpt. Bewuster waar het niet helpt.</h3>
              <span class="teasers__card-arrow">Lees meer →</span>
            </div>
          </a>

          <a href="/trainingen/verantwoord-ai" class="teasers__card reveal reveal-delay-2">
            <div class="teasers__card-photo">
              <img
                src="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=800&q=80"
                alt="Team in gesprek over verantwoord AI gebruik"
                loading="lazy"
              />
            </div>
            <div class="teasers__card-body">
              <span class="teasers__card-num">03</span>
              <p class="teasers__label">Verantwoord omgaan met AI</p>
              <h3 class="teasers__title">De mens aan het stuur. Niet als rem, maar als fundament.</h3>
              <span class="teasers__card-arrow">Lees meer →</span>
            </div>
          </a>

        </div>
      </div>
    </section>

    <!-- Modern Meeting Skills — e-learning preview -->
    <section class="elearning-preview">
      <div class="container">
        <div class="elearning-preview__inner">
          <div class="elearning-preview__text reveal">
            <p class="elearning-preview__kicker">Ook digitaal beschikbaar</p>
            <h2 class="elearning-preview__title">Modern Meeting Skills — ook als e-learning.</h2>
            <p class="elearning-preview__body">8 modules, 4,5 uur, zelfstandig te doorlopen.</p>
            <a href="/elearning" class="elearning-preview__link">Bekijk de e-learning →</a>
          </div>
          <div class="elearning-preview__screenshot reveal reveal-delay-1">
            <div class="elearning__screenshot">
              <img src="/images/modern-meeting-skills-module-overzicht.png" alt="Modern Meeting Skills e-learning — moduleoverzicht" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>
