---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Nav />
  <main>

    <!-- ① DONKER — Hero -->
    <Hero />

    <!-- Marquee trust strip -->
    <Marquee />

    <!-- ③ LICHT — Probleem -->
    <section class="problem" data-nav="light">
      <div class="container">
        <div class="problem__inner">
          <div class="problem__content">
            <h2 class="problem__heading reveal">
              Wat gaat er eigenlijk mis?
            </h2>
            <div class="problem__body reveal reveal-delay-1">
              <p>
                De gemiddelde professional verliest <span class="stat">31 uur</span> per
                maand aan vergaderingen die achteraf als zinloos worden ervaren. Dat zijn
                meer dan vier werkdagen. Niet omdat mensen het slecht bedoelen — maar
                omdat niemand ze ooit heeft geleerd hoe vergaderen eigenlijk werkt.
              </p>
              <p>
                Dat is geen karakterfout van de mensen erin. Het is een ontwerpfout.
              </p>
            </div>
          </div>
          <div class="problem__photo reveal">
            <img
              src="https://images.unsplash.com/photo-1573164713714-d95e436ab8d6?w=900&q=80"
              alt="Vergadering in een moderne werkruimte"
              loading="lazy"
              decoding="async"
              width="900"
              height="675"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ④ DONKER — Trainingen als verhaal -->
    <section class="proof-section" id="resultaten-home">
      <div class="container">

        <p class="proof-header reveal">2 trainingen. Gemiddeld een 9.3.</p>

        <!-- Training 1 -->
        <div class="proof-training reveal">
          <span class="proof-training__score" data-counter="9.4">9.4</span>
          <div class="proof-training__meta">
            <span class="proof-training__org">CITI Curaçao</span>
            <span class="proof-training__date">juni 2026</span>
          </div>
          <div class="proof-training__quotes">
            <p class="proof-training__quote">"Authentiek."</p>
            <p class="proof-training__quote">"Staat rustig en stevig voor de groep, goede interactie en procesbewaking."</p>
          </div>
        </div>

        <!-- Training 2 -->
        <div class="proof-training reveal">
          <span class="proof-training__score" data-counter="9.2">9.2</span>
          <div class="proof-training__meta">
            <span class="proof-training__org">Curaçao</span>
            <span class="proof-training__date">juni 2026</span>
          </div>
          <div class="proof-training__quotes">
            <p class="proof-training__quote">"Heel interactief. Goed betrokken, pakt het snel weer op."</p>
            <p class="proof-training__quote">"Goede structuur, goede afwisseling tussen theorie, praktijk en oefening."</p>
          </div>
        </div>

        <!-- Typering chips -->
        <div class="proof-typeringen reveal">
          <p class="proof-typeringen__label">Hoe deelnemers Jesse typeren</p>
          <div class="proof-typeringen__chips">
            <span class="proof-chip proof-chip--lg">Duidelijk &amp; gestructureerd</span>
            <span class="proof-chip proof-chip--lg">Enthousiast &amp; energiek</span>
            <span class="proof-chip proof-chip--md">Betrokken &amp; afgestemd</span>
            <span class="proof-chip proof-chip--sm">Deskundig &amp; inhoudelijk sterk</span>
          </div>
        </div>

        <!-- Logo's + CTA -->
        <div class="proof-bottom reveal">
          <div class="proof-logos">
            <img src="/images/CITI.png" alt="CITI" loading="lazy" decoding="async" height="28" />
            <img src="/images/YouMeet.jpeg" alt="YouMeet" loading="lazy" decoding="async" height="28" />
          </div>
          <a href="/over#resultaten" class="proof-meer">
            Bekijk alle reacties →
          </a>
        </div>

      </div>
    </section>

    <!-- ⑤ DONKER — Trainingen verticale lijst -->
    <section class="training-list-section">
      <div class="container">
        <p class="training-list-section__kicker reveal">De trainingen</p>
        <nav class="training-list" aria-label="Trainingen">

          <a href="/trainingen/effectief-vergaderen" class="training-list__item reveal">
            <span class="training-list__num">01</span>
            <span class="training-list__content">
              <span class="training-list__title">Effectief vergaderen</span>
              <span class="training-list__sub">Vergaderen dat ergens op uitkomt — voor teams die minder willen verspillen</span>
            </span>
            <span class="training-list__arrow">→</span>
            <span class="training-list__thumb">
              <img src="/images/jesse-masterclass-scherm.jpg" alt="" loading="lazy" decoding="async" width="280" height="180" />
            </span>
          </a>

          <a href="/trainingen/ai-hulpmiddel" class="training-list__item reveal">
            <span class="training-list__num">02</span>
            <span class="training-list__content">
              <span class="training-list__title">AI als hulpmiddel op de werkvloer</span>
              <span class="training-list__sub">Sneller waar het helpt. Bewuster waar het niet helpt.</span>
            </span>
            <span class="training-list__arrow">→</span>
            <span class="training-list__thumb">
              <img src="https://images.unsplash.com/photo-1499750310107-5fef28a66643?w=400&q=80" alt="" loading="lazy" decoding="async" width="280" height="180" />
            </span>
          </a>

          <a href="/trainingen/verantwoord-ai" class="training-list__item reveal">
            <span class="training-list__num">03</span>
            <span class="training-list__content">
              <span class="training-list__title">Verantwoord omgaan met AI</span>
              <span class="training-list__sub">De mens aan het stuur — niet als rem, maar als fundament</span>
            </span>
            <span class="training-list__arrow">→</span>
            <span class="training-list__thumb">
              <img src="https://images.unsplash.com/photo-1521737604893-d14cc237f11d?w=400&q=80" alt="" loading="lazy" decoding="async" width="280" height="180" />
            </span>
          </a>

        </nav>
      </div>
    </section>

    <!-- ⑥ LICHT — Over Jesse -->
    <section class="about-home" data-nav="light">
      <div class="about-home__inner">
        <div class="about-home__photo reveal">
          <img
            src="/images/jesse-training.jpg"
            alt="Jesse Venniker in training — psycholoog en trainer"
            loading="lazy"
            decoding="async"
            width="600"
            height="800"
          />
        </div>
        <div class="about-home__text">
          <p class="about-home__kicker reveal">Over Jesse</p>
          <h2 class="about-home__heading reveal reveal-delay-1">
            Ik werk met mensen, niet aan mensen.
          </h2>
          <p class="about-home__body reveal reveal-delay-2">
            Ik ben psycholoog. Ik heb Jesco Trainingen opgericht omdat ik zag hoeveel
            tijd en energie er verloren gaat in vergaderingen die nergens op uitkomen —
            en in teams die AI willen begrijpen maar niet weten waar te beginnen.
          </p>
          <p class="about-home__body reveal reveal-delay-2">
            Wat maandag geleerd wordt, gebruik je dinsdag. Zo werkt mijn aanpak:
            direct bruikbaar, gedragsgericht, en altijd verankerd in de echte situatie
            van jouw team.
          </p>
          <div class="about-home__facts reveal">
            <p class="about-home__fact">Toegepast psycholoog</p>
            <p class="about-home__fact">Trainer en ontwikkelaar van leertrajecten</p>
            <p class="about-home__fact">Jesco Innovation BV</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ⑦ DONKER — Contact simple -->
    <section class="contact-simple">
      <div class="container">
        <p class="contact-simple__question reveal">
          Past dit bij wat jij zoekt?
        </p>
        <p class="contact-simple__body reveal reveal-delay-1">
          Stuur een mail. Dan plannen we een kort gesprek om te kijken of het klopt
          — zonder verplichtingen en zonder standaard pitch.
        </p>
        <a
          href="mailto:jesse.venniker@gmail.com"
          class="contact-simple__email reveal reveal-delay-2"
        >
          jesse.venniker@gmail.com
        </a>
      </div>
    </section>

  </main>
  <Footer />
</Layout>
