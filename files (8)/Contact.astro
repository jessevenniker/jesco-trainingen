---
---

<section class="contact" id="contact">
  <div class="container">
    <div class="contact__inner">
      <div>
        <h2 class="contact__title reveal">
          Benieuwd wat dit voor jouw team kan doen?
        </h2>

        <p class="contact__body reveal reveal-delay-1">
          Stuur me een mail. Vertel kort wat er speelt in je organisatie,
          dan kijk ik met je mee wat er nodig is. Geen verplichtingen,
          geen standaard pitch.
        </p>

        <a
          href="mailto:info@jescoinnovation.nl"
          class="contact__link reveal reveal-delay-2"
        >
          info@jescoinnovation.nl
          <span class="contact__link-arrow" aria-hidden="true">&#8594;</span>
        </a>
      </div>

      <div class="contact__side reveal reveal-delay-1">
        <div>
          <p class="contact__detail-label">Bedrijf</p>
          <p class="contact__detail-value">Jesco Innovation BV</p>
        </div>
        <div>
          <p class="contact__detail-label">Mail</p>
          <a href="mailto:info@jescoinnovation.nl" class="contact__detail-value" style="color: inherit;">
            info@jescoinnovation.nl
          </a>
        </div>
        <div>
          <p class="contact__detail-label">Trainingsmerk</p>
          <p class="contact__detail-value">Jesco Training</p>
        </div>
      </div>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="container">
    <div class="footer__inner">
      <span>&#169; 2025 Jesco Innovation BV</span>
      <span>KVK: &lt;nummer invullen&gt;</span>
    </div>
  </div>
</footer>
